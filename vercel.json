      "destination": "/airlines/korean-air",
      "permanent": true
    },
    {
      "source": "/airlines/ana.html",
      "destination": "/airlines/ana",
      "permanent": true
    },
    {
      "source": "/airlines/delta.html",
      "destination": "/airlines/delta",
      "permanent": true
    },
    {
      "source": "/airlines/japan-airlines-jal.html",
      "destination": "/airlines/japan-airlines-jal",
      "permanent": true
    },
    {
      "source": "/airlines/alaska-airlines.html",
